  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 647e11c901d4942f796c70486dc1855f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractTrigger
  interactDistance: 2
  dialogue:
    name: Tobin
    sentences:
    - Didn't mean to cause trouble. Guess that's just how you get welcomed 'round
      here.
    - I just brushed the mug, I swear! Didn't think the old man guarded it like a
      dragon's hoard.
    - Old Thom's got a right hook for the ages, I'll say. My ears are still ringing.
    - He calmed down after I got him another ale. Think that's the secret to peace
      in this place.
  dialogueManager: {fileID: 566788076}
  promptText: {fileID: 1974932509}
