  m_Name: 
  m_EditorClassIdentifier: '::'
  interactDistance: 2
  dialogue:
    name: Merrit Grigg
    sentences:
    - Welcome in to the Drunken Griffin. Can I getcha anything?
    - Don't mind the mess, happens twice a week, give or take.
    - Old Thom had his fifteenth mug knocked over by Tobin, you know how it goes.
    - I just hope they leave enough coin for new chairs this time.
  dialogueManager: {fileID: 566788076}
  promptText: {fileID: 1974932509}
