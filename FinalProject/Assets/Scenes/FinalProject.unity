  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractTrigger
  interactDistance: 2
  dialogue:
    name: Old Thom
    sentences:
    - You here to buy the next round or just gawk at an old man's misfortune?
    - Aye, I threw a punch or two. But only for the sake o' the drink, mind you.
    - Bah. Next time, I'm drinkin' straight from the barrel. Harder to knock over.
  dialogueManager: {fileID: 566788076}
  promptText: {fileID: 1974932509}
